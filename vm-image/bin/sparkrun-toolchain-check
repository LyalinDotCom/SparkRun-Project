#!/usr/bin/env python3
"""Inventory and smoke-test the tools promised by the SparkRun VM image."""

from __future__ import annotations

import argparse
import json
import os
import pathlib
import pty
import shutil
import sqlite3
import subprocess
import tempfile


DEFAULT_TIMEOUT_SECONDS = 90
BUILD_TIMEOUT_SECONDS = 180

COMMANDS: dict[str, list[str]] = {
    "bash": ["bash", "--version"],
    "zsh": ["zsh", "--version"],
    "git": ["git", "--version"],
    "git-lfs": ["git-lfs", "version"],
    "ssh": ["ssh", "-V"],
    "curl": ["curl", "--version"],
    "wget": ["wget", "--version"],
    "dig": ["dig", "-v"],
    "node": ["node", "--version"],
    "npm": ["npm", "--version"],
    "npx": ["npx", "--version"],
    "pnpm": ["pnpm", "--version"],
    "yarn": ["yarn", "--version"],
    "python": ["python3", "--version"],
    "pip": ["pip3", "--version"],
    "pipx": ["pipx", "--version"],
    "go": ["go", "version"],
    "gcc": ["gcc", "--version"],
    "g++": ["g++", "--version"],
    "make": ["make", "--version"],
    "cmake": ["cmake", "--version"],
    "ninja": ["ninja", "--version"],
    "gdb": ["gdb", "--version"],
    "sqlite": ["sqlite3", "--version"],
    "jq": ["jq", "--version"],
    "ripgrep": ["rg", "--version"],
    "fd": ["fd", "--version"],
    "tmux": ["tmux", "-V"],
    "rsync": ["rsync", "--version"],
    "socat": ["socat", "-V"],
    "netcat": ["nc", "-h"],
    "lsof": ["lsof", "-v"],
}


def run(
    command: list[str],
    *,
    cwd: pathlib.Path | None = None,
    timeout_seconds: int = DEFAULT_TIMEOUT_SECONDS,
    env: dict[str, str] | None = None,
) -> subprocess.CompletedProcess[str]:
    merged_env = {**os.environ, "LC_ALL": "C.UTF-8", **(env or {})}
    try:
        return subprocess.run(
            command,
            cwd=cwd,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=timeout_seconds,
            check=False,
            env=merged_env,
        )
    except subprocess.TimeoutExpired as error:
        output = error.stdout or ""
        if isinstance(output, bytes):
            output = output.decode(errors="replace")
        return subprocess.CompletedProcess(
            command,
            124,
            f"{output}\nTimed out after {timeout_seconds} seconds.",
        )


def require_success(
    command: list[str],
    expected_output: str,
    *,
    cwd: pathlib.Path,
    label: str,
    timeout_seconds: int = DEFAULT_TIMEOUT_SECONDS,
    env: dict[str, str] | None = None,
) -> None:
    completed = run(
        command,
        cwd=cwd,
        timeout_seconds=timeout_seconds,
        env=env,
    )
    if completed.returncode != 0 or expected_output not in completed.stdout:
        raise RuntimeError(
            f"{label} failed with status {completed.returncode}: {completed.stdout}"
        )


def require_status(
    command: list[str],
    expected_status: int,
    *,
    cwd: pathlib.Path,
    label: str,
    timeout_seconds: int = DEFAULT_TIMEOUT_SECONDS,
    env: dict[str, str] | None = None,
) -> subprocess.CompletedProcess[str]:
    completed = run(
        command,
        cwd=cwd,
        timeout_seconds=timeout_seconds,
        env=env,
    )
    if completed.returncode != expected_status:
        raise RuntimeError(
            f"{label} returned {completed.returncode}, expected {expected_status}: "
            f"{completed.stdout}"
        )
    return completed


def run_bytes(
    command: list[str],
    *,
    cwd: pathlib.Path,
    timeout_seconds: int = DEFAULT_TIMEOUT_SECONDS,
) -> subprocess.CompletedProcess[bytes]:
    try:
        return subprocess.run(
            command,
            cwd=cwd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=timeout_seconds,
            check=False,
            env={**os.environ, "LC_ALL": "C.UTF-8"},
        )
    except subprocess.TimeoutExpired as error:
        return subprocess.CompletedProcess(
            command,
            124,
            (error.stdout or b"") + b"\nTimed out.",
            error.stderr or b"",
        )


def node_compatibility_smoke(directory: pathlib.Path) -> dict[str, object]:
    preload = pathlib.Path("/usr/local/lib/sparkrun/node-exit-preload.cjs")
    addon = pathlib.Path("/usr/local/lib/sparkrun/node-exit-addon.node")
    expected_option = f"--require={preload}"
    if not preload.is_file() or not addon.is_file():
        raise RuntimeError("Node exit compatibility files are missing")
    if expected_option not in os.environ.get("NODE_OPTIONS", "").split():
        raise RuntimeError(f"NODE_OPTIONS does not preload {preload}")

    require_status(
        ["node", "-e", "void 0"], 0, cwd=directory, label="natural Node exit"
    )
    require_status(
        ["node", "-e", "process.exit(7)"],
        7,
        cwd=directory,
        label="explicit Node exit",
    )
    require_status(
        ["node", "-e", "process.exitCode = 7"],
        7,
        cwd=directory,
        label="deferred Node exit code",
    )
    require_status(
        [
            "node",
            "-e",
            "process.on('exit', () => { process.exitCode = 7; })",
        ],
        7,
        cwd=directory,
        label="Node exit listener status override",
    )
    require_status(
        [
            "node",
            "-e",
            "process.on('exit', () => { process.exitCode = 7; }); "
            "process.on('exit', () => { process.exitCode = 9; })",
        ],
        9,
        cwd=directory,
        label="Node final exit listener status wins",
    )
    require_status(
        [
            "node",
            "-e",
            "process.on('exit', () => { process.exit(9); })",
        ],
        9,
        cwd=directory,
        label="Node process.exit inside an exit listener",
    )
    require_status(
        [
            "node",
            "-e",
            "process.on('exit', () => { throw new Error('expected-exit-error') })",
        ],
        1,
        cwd=directory,
        label="Node exit listener exception",
    )
    require_status(
        ["node", "-e", "process.exitCode = 7"],
        7,
        cwd=directory,
        label="Node exit with compile cache disabled",
        env={"NODE_DISABLE_COMPILE_CACHE": "1"},
    )
    require_status(
        ["node", "-e", "throw new Error('expected-conformance-error')"],
        1,
        cwd=directory,
        label="uncaught Node exception",
    )

    exit_marker = directory / "node-exit-handler.txt"
    require_status(
        [
            "node",
            "-e",
            "require('node:fs').writeFileSync(process.argv[1], 'exit-handler-ok'); "
            "process.on('exit', () => "
            "require('node:fs').appendFileSync(process.argv[1], ':ran'))",
            str(exit_marker),
        ],
        0,
        cwd=directory,
        label="Node user exit handler",
    )
    if exit_marker.read_text(encoding="utf-8") != "exit-handler-ok:ran":
        raise RuntimeError("Node user exit handler did not finish")

    worker = require_status(
        [
            "node",
            "-e",
            "const { Worker } = require('node:worker_threads'); "
            "const w = new Worker(\"require('node:worker_threads').parentPort"
            ".postMessage('worker-ok')\", { eval: true }); "
            "w.once('message', console.log); "
            "w.once('error', (error) => { console.error(error); process.exitCode = 1; });",
        ],
        0,
        cwd=directory,
        label="Node worker_threads",
    )
    if "worker-ok" not in worker.stdout:
        raise RuntimeError(f"Node worker output missing: {worker.stdout}")

    fork_child = directory / "fork-child.cjs"
    fork_parent = directory / "fork-parent.cjs"
    fork_child.write_text(
        "process.send('fork-ok');\n",
        encoding="utf-8",
    )
    fork_parent.write_text(
        "const { fork } = require('node:child_process');\n"
        "const child = fork(process.argv[2], [], "
        "{ stdio: ['ignore', 'ignore', 'inherit', 'ipc'] });\n"
        "child.once('message', (message) => console.log(message));\n"
        "child.once('error', (error) => { console.error(error); process.exitCode = 1; });\n",
        encoding="utf-8",
    )
    forked = require_status(
        ["node", str(fork_parent), str(fork_child)],
        0,
        cwd=directory,
        label="Node child_process fork",
    )
    if "fork-ok" not in forked.stdout:
        raise RuntimeError(f"Node fork output missing: {forked.stdout}")

    output_size = 200 * 1024
    large_output = run_bytes(
        [
            "node",
            "-e",
            f"process.stdout.write(Buffer.alloc({output_size}, 120))",
        ],
        cwd=directory,
    )
    if (
        large_output.returncode != 0
        or len(large_output.stdout) != output_size
        or large_output.stdout != b"x" * output_size
    ):
        raise RuntimeError(
            "Node 200 KiB stdout integrity failed: "
            f"status={large_output.returncode}, bytes={len(large_output.stdout)}, "
            f"stderr={large_output.stderr.decode(errors='replace')}"
        )

    subsequent = require_status(
        ["node", "-e", "console.log('subsequent-node-ok')"],
        0,
        cwd=directory,
        label="subsequent Node command",
    )
    if "subsequent-node-ok" not in subsequent.stdout:
        raise RuntimeError("Subsequent Node command output missing")

    expected_versions = {
        "npm": "11.12.1",
        "pnpm": "11.20.0",
        "yarn": "1.22.22",
    }
    versions: dict[str, str] = {}
    for executable, expected in expected_versions.items():
        result = require_status(
            [executable, "--version"],
            0,
            cwd=directory,
            label=f"{executable} version",
        )
        version = result.stdout.strip()
        if version != expected:
            raise RuntimeError(
                f"{executable} version is {version!r}, expected {expected!r}"
            )
        versions[executable] = version

    return {
        "conformancePassed": True,
        "preload": str(preload),
        "addon": str(addon),
        "compileCacheDisabledStatusVerified": 7,
        "exitListenerStatusVerified": 9,
        "stdoutBytesVerified": output_size,
        "packageManagers": versions,
    }


def inventory() -> tuple[dict[str, dict[str, object]], list[str]]:
    result: dict[str, dict[str, object]] = {}
    missing: list[str] = []
    for name, command in COMMANDS.items():
        executable = shutil.which(command[0])
        if executable is None:
            missing.append(name)
            result[name] = {"available": False}
            continue
        completed = run(command)
        first_line = completed.stdout.strip().splitlines()
        result[name] = {
            "available": True,
            "executable": executable,
            "status": completed.returncode,
            "version": first_line[0] if first_line else "",
        }
    return result, missing


def smoke() -> dict[str, object]:
    with tempfile.TemporaryDirectory(prefix="sparkrun-toolchain-") as raw_directory:
        directory = pathlib.Path(raw_directory)

        node_compatibility = node_compatibility_smoke(directory)

        require_success(
            ["node", "-e", "console.log('node-ok')"],
            "node-ok",
            cwd=directory,
            label="Node execution smoke",
        )

        dependency = directory / "fixture-message"
        dependency.mkdir()
        (dependency / "package.json").write_text(
            json.dumps(
                {
                    "name": "fixture-message",
                    "version": "1.0.0",
                    "main": "index.js",
                }
            ),
            encoding="utf-8",
        )
        (dependency / "index.js").write_text(
            "module.exports = () => 'npm-build-ok';\n",
            encoding="utf-8",
        )
        (directory / "package.json").write_text(
            json.dumps(
                {
                    "name": "sparkrun-node-smoke",
                    "version": "1.0.0",
                    "private": True,
                    "scripts": {"build": "node build.js"},
                    "dependencies": {"fixture-message": "file:./fixture-message"},
                }
            ),
            encoding="utf-8",
        )
        (directory / "build.js").write_text(
            "const fs = require('node:fs');\n"
            "const message = require('fixture-message')();\n"
            "fs.mkdirSync('dist', { recursive: true });\n"
            "fs.writeFileSync('dist/result.js', `console.log('${message}')\\n`);\n",
            encoding="utf-8",
        )
        require_success(
            [
                "npm",
                "install",
                "--offline",
                "--ignore-scripts",
                "--no-audit",
                "--no-fund",
            ],
            "added 1 package",
            cwd=directory,
            label="npm local install smoke",
            timeout_seconds=BUILD_TIMEOUT_SECONDS,
        )
        require_success(
            ["npm", "run", "build", "--silent"],
            "",
            cwd=directory,
            label="npm build smoke",
            timeout_seconds=BUILD_TIMEOUT_SECONDS,
        )
        require_success(
            ["node", "dist/result.js"],
            "npm-build-ok",
            cwd=directory,
            label="npm build output smoke",
        )

        python_thread = run(
            [
                "python3",
                "-c",
                "import threading; values = []; "
                "thread = threading.Thread(target=lambda: values.append('python-thread-ok')); "
                "thread.start(); thread.join(10); "
                "assert not thread.is_alive() and values == ['python-thread-ok']; "
                "print(values[0])",
            ],
            cwd=directory,
        )
        if python_thread.returncode != 0 or "python-thread-ok" not in python_thread.stdout:
            raise RuntimeError(f"Python thread smoke failed: {python_thread.stdout}")

        python = run(
            ["python3", "-c", "import sqlite3; print(sqlite3.sqlite_version)"],
            cwd=directory,
        )
        if python.returncode != 0:
            raise RuntimeError(f"Python smoke failed: {python.stdout}")

        c_source = directory / "hello.c"
        c_source.write_text(
            '#include <stdio.h>\nint main(void) { puts("c-ok"); return 0; }\n',
            encoding="utf-8",
        )
        require_success(
            ["gcc", "hello.c", "-o", "hello-c"],
            "",
            cwd=directory,
            label="C compile smoke",
            timeout_seconds=BUILD_TIMEOUT_SECONDS,
        )
        require_success(
            [str(directory / "hello-c")],
            "c-ok",
            cwd=directory,
            label="C execution smoke",
        )

        pthread_source = directory / "pthread-check.c"
        pthread_source.write_text(
            "#include <pthread.h>\n"
            "#include <stdio.h>\n"
            "static void *worker(void *raw) { *(int *)raw = 42; return raw; }\n"
            "int main(void) {\n"
            "  pthread_t thread; int value = 0; void *result = NULL;\n"
            "  if (pthread_create(&thread, NULL, worker, &value) != 0) return 1;\n"
            "  if (pthread_join(thread, &result) != 0) return 2;\n"
            "  if (result != &value || value != 42) return 3;\n"
            "  puts(\"pthread-ok\"); return 0;\n"
            "}\n",
            encoding="utf-8",
        )
        require_success(
            ["gcc", "-pthread", "pthread-check.c", "-o", "pthread-check"],
            "",
            cwd=directory,
            label="pthread compile smoke",
            timeout_seconds=BUILD_TIMEOUT_SECONDS,
        )
        require_success(
            [str(directory / "pthread-check")],
            "pthread-ok",
            cwd=directory,
            label="pthread create/join smoke",
        )

        pthread_condition_source = directory / "pthread-condition-check.c"
        pthread_condition_source.write_text(
            "#include <pthread.h>\n"
            "#include <stdio.h>\n"
            "static pthread_mutex_t mutex = PTHREAD_MUTEX_INITIALIZER;\n"
            "static pthread_cond_t condition = PTHREAD_COND_INITIALIZER;\n"
            "static int ready = 0; static int released = 0;\n"
            "static void *worker(void *unused) {\n"
            "  (void)unused; pthread_mutex_lock(&mutex); ready = 1;\n"
            "  pthread_cond_broadcast(&condition);\n"
            "  while (!released) pthread_cond_wait(&condition, &mutex);\n"
            "  pthread_mutex_unlock(&mutex); return NULL;\n"
            "}\n"
            "int main(void) {\n"
            "  pthread_t thread; if (pthread_create(&thread, NULL, worker, NULL)) return 1;\n"
            "  pthread_mutex_lock(&mutex);\n"
            "  while (!ready) pthread_cond_wait(&condition, &mutex);\n"
            "  released = 1; pthread_cond_broadcast(&condition);\n"
            "  pthread_mutex_unlock(&mutex);\n"
            "  if (pthread_join(thread, NULL)) return 2;\n"
            "  puts(\"pthread-condition-ok\"); return 0;\n"
            "}\n",
            encoding="utf-8",
        )
        require_success(
            [
                "gcc",
                "-pthread",
                "pthread-condition-check.c",
                "-o",
                "pthread-condition-check",
            ],
            "",
            cwd=directory,
            label="parked pthread condition-variable compile",
            timeout_seconds=BUILD_TIMEOUT_SECONDS,
        )
        require_success(
            [str(directory / "pthread-condition-check")],
            "pthread-condition-ok",
            cwd=directory,
            label="parked pthread condition-variable broadcast/join",
        )

        go_source = directory / "hello.go"
        go_source.write_text(
            'package main\nimport "fmt"\nfunc main() { fmt.Println("go-ok") }\n',
            encoding="utf-8",
        )
        require_success(
            ["go", "build", "-o", "hello-go", "hello.go"],
            "",
            cwd=directory,
            label="Go compile smoke",
            timeout_seconds=BUILD_TIMEOUT_SECONDS,
            env={"GOCACHE": str(directory / ".go-cache")},
        )
        require_success(
            [str(directory / "hello-go")],
            "go-ok",
            cwd=directory,
            label="Go execution smoke",
        )

        database = sqlite3.connect(directory / "smoke.sqlite")
        database.execute("create table smoke (value text not null)")
        database.execute("insert into smoke values ('sqlite-ok')")
        value = database.execute("select value from smoke").fetchone()
        database.close()
        if value != ("sqlite-ok",):
            raise RuntimeError("SQLite smoke failed")

        master, slave = pty.openpty()
        os.close(master)
        os.close(slave)

        return node_compatibility


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--json", action="store_true", help="print machine-readable inventory")
    parser.add_argument("--smoke", action="store_true", help="compile and run representative programs")
    args = parser.parse_args()

    tools, missing = inventory()
    node_compatibility: dict[str, object] = {"conformancePassed": False}
    if args.smoke:
        node_compatibility = smoke()

    userspace_architecture = run(["apk", "--print-arch"]).stdout.strip()
    bash_binary = run(["file", "-b", "/bin/bash"]).stdout.strip()
    libc = run(["ldd", "--version"]).stdout.strip()
    compile_cache = pathlib.Path(
        os.environ.get(
            "NODE_COMPILE_CACHE",
            "/usr/local/lib/sparkrun/node-compile-cache",
        )
    )
    compile_cache_files = (
        sum(1 for path in compile_cache.rglob("*") if path.is_file())
        if compile_cache.is_dir()
        else 0
    )
    report = {
        "schemaVersion": 1,
        "architecture": userspace_architecture,
        "kernelArchitecture": os.uname().machine,
        "libc": libc,
        "bashBinary": bash_binary,
        "tools": tools,
        "nodeCompatibility": node_compatibility,
        "nodeCompileCache": {
            "path": str(compile_cache),
            "mode": oct(compile_cache.stat().st_mode & 0o777)
            if compile_cache.exists()
            else None,
            "fileCount": compile_cache_files,
        },
        "smokePassed": bool(args.smoke),
    }
    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        for name, details in tools.items():
            marker = "ok" if details["available"] else "missing"
            print(f"{marker:7} {name:10} {details.get('version', '')}")

    if missing:
        print(f"Missing required tools: {', '.join(missing)}")
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
