# SparkRun intentionally does not expose host environment variables to the
# browser bundle. Enter Gemini and Tailscale credentials in Setup at runtime.
#
# Maintainer-only CLI/E2E tooling may read these unprefixed values locally.
# Never rename them with VITE_: Vite would embed those values in public JS.
# TAILSCALE_AUTH_KEY must be an enrollment auth key (tskey-auth-...), not a
# Tailscale API access token. Keep populated .env files untracked.
GEMINI_API_KEY=
TAILSCALE_AUTH_KEY=
